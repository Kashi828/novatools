# Get these from https://dashboard.clerk.com -> your app -> API Keys
# Free to create, no credit card required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Get these from https://console.upstash.com -> create a free Redis database -> REST API section
# Powers comments and persistent Nova AI usage limits when configured.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Your own email (must match a verified email on your Clerk account). This account is the Nova AI admin.
ADMIN_EMAIL=you@example.com

# Nova AI: create a Gemini API key in Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default model.
GEMINI_MODEL=gemini-3.1-flash-lite
