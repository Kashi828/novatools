# Get these from https://dashboard.clerk.com -> your app -> API Keys
# Free to create, no credit card required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Get these from https://console.upstash.com -> create a free Redis database -> REST API section
# Powers the public comments feature on /feedback. Free tier is generous, no card required.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Your own email (must match a verified email on your Clerk account). Only this account
# will see delete buttons on the /feedback comments page.
ADMIN_EMAIL=you@example.com
